---
/**
 * Untuk creator (#creator): "Kamu creator?", headline, lead, chip "untuk siapa", dan
 * kutipan creator sebagai bubble chat.
 *
 * Mobile: chip dalam satu baris yang bisa digeser; tanpa paragraf tambahan dan catatan gratis.
 * Desktop (1100px+): teks 6 kolom kiri, kutipan + catatan + CTA di kolom 7-12.
 */
import { ANCHORS, forCreators } from '../../data/content';
import { getUser } from '../../data/users';
import Username from '../Username.astro';
import Avatar from '../Avatar.astro';
---

<section id={ANCHORS.creator} aria-labelledby="forcreators-heading" class="section-y">
  <div class="container-page grid gap-6 wide:grid-cols-12 wide:items-start wide:gap-x-12 wide:gap-y-8">
    <div class="flex min-w-0 flex-col gap-6 wide:col-span-6 wide:gap-[22px]">
      <p class="ask-bubble">{forCreators.ask}</p>
      <h2 id="forcreators-heading" class="heading-section">{forCreators.heading}</h2>
      <p class="lead-section">{forCreators.lead}</p>
      <p class="lead-section hidden wide:block wide:text-[17px] wide:leading-[27px]">{forCreators.leadExtra}</p>
      <ul aria-label="Untuk siapa" class="audiences">
        {forCreators.audiences.map((label) => <li class="kn-chip">{label}</li>)}
      </ul>
    </div>

    <div class="flex flex-col gap-2 wide:col-span-6 wide:col-start-7 wide:gap-2.5 wide:pt-[74px]">
      {
        forCreators.quotes.map((quote) => {
          const user = getUser(quote.userId);
          return (
            <div class="kn-msg cr-msg">
              <Avatar class="kn-avatar cr-av" user={user} size={48} />
              <div class="kn-msg__body gap-1 wide:gap-1.5">
                <span class="cr-name" style={`color: ${user.nameColor}`}>
                  <Username name={user.username} />
                </span>
                <div class="kn-bubble kn-bubble--other cr-bubble">
                  {quote.text}
                  <span class="chat-ts">{quote.time}</span>
                </div>
              </div>
            </div>
          );
        })
      }
      <p class="plan-note">{forCreators.planNote}</p>
      <p class="m-0 mt-2.5 hidden text-[17px] leading-[26px] font-semibold wide:block">{forCreators.freeNote}</p>
      <a class="kn-btn kn-btn--secondary kn-btn--lg kn-btn--block mt-4 wide:mt-3.5 wide:w-auto wide:self-start" href={forCreators.cta.href} data-pick-tab="creator">
        {forCreators.cta.label}
      </a>
    </div>
  </div>
</section>

<style>
  /* Chip untuk siapa: mobile satu baris yang bisa digeser (tanpa scrollbar), desktop membungkus */
  .audiences {
    display: flex;
    flex-wrap: nowrap;
    gap: 8px;
    margin: 0 calc(var(--space-5) * -1);
    padding: 0 var(--space-5) 2px;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .audiences::-webkit-scrollbar {
    display: none;
  }
  .audiences .kn-chip {
    flex-shrink: 0;
    height: 40px;
    font-size: 12px;
    cursor: default;
  }
  .audiences .kn-chip:hover {
    background: transparent;
  }

  .cr-msg {
    max-width: 100%;
    align-items: flex-start;
    gap: 10px;
  }
  .cr-av {
    --s: 36px;
    margin-top: 20px;
    object-fit: cover;
  }
  .cr-name {
    padding: 0 6px;
    font: 700 14px/18px var(--font-sans);
    letter-spacing: 0.01em;
  }
  .cr-bubble {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    padding: 10px 12px 8px 14px;
    font-size: 16px;
    line-height: 24px;
  }
  .plan-note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 2px 0 0 46px;
    font: 500 16px/22px var(--font-sans);
    color: var(--ink-muted);
  }
  .plan-note::before {
    content: '';
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--secondary);
  }

  @media (min-width: 768px) {
    .audiences {
      flex-wrap: wrap;
      margin: 4px 0 0;
      padding: 0;
      gap: 10px;
      overflow: visible;
    }
    .audiences .kn-chip {
      font-size: 13px;
    }
  }

  @media (min-width: 1100px) {
    .cr-msg {
      gap: 12px;
    }
    .cr-av {
      --s: 48px;
      margin-top: 24px;
    }
    .cr-bubble {
      gap: 12px;
      padding: 12px 18px 10px 20px;
      font-size: 18px;
      line-height: 27px;
    }
    .plan-note {
      margin: 4px 0 0 60px;
      font-size: 14px;
      line-height: 20px;
    }
  }
</style>
