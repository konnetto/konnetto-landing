---
/**
 * Masalah: "Budaya otaku Indonesia hidup. Tapi tercecer."
 *
 * Mobile: judul + tiga baris ringkas (copy pendek), tanpa lead dan tanpa bubble penutup.
 * Tablet (768px+): copy desktop, lead, dan bubble penutup; baris masih bertumpuk.
 * Desktop (1100px+): judul 7 kolom + lead di kolom 9-12, tiga baris bertangga
 * (indent 0 / 180 / 360px) dengan judul besar di kiri, bubble pink penutup rata kanan.
 */
import { problem } from '../../data/content';
---

<section aria-labelledby="problem-heading" class="section-y md:bg-surface-sunken">
  <div class="container-page flex flex-col gap-6 md:gap-11">
    <div class="grid gap-4 wide:grid-cols-12 wide:items-end wide:gap-12">
      <h2 id="problem-heading" class="heading-section wide:col-span-7">{problem.heading}</h2>
      <p class="lead-section hidden md:block wide:col-span-4 wide:col-start-9">{problem.lead}</p>
    </div>

    <ul class="problem-rows">
      {
        problem.rows.map((row) => (
          <li class="problem-row">
            <b class="problem-title">{row.title}</b>
            <span class="problem-body md:hidden">{row.bodyMobile}</span>
            <span class="problem-body hidden md:block">{row.body}</span>
          </li>
        ))
      }
    </ul>

    <p class="problem-closing hidden md:block">{problem.closing}</p>
  </div>
</section>

<style>
  .problem-rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .problem-row {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px dashed var(--line);
  }
  .problem-title {
    font: 800 17px/24px var(--font-sans);
    color: var(--ink);
  }
  .problem-body {
    font: 400 16px/24px var(--font-sans);
    color: var(--ink-muted);
  }

  .problem-closing {
    align-self: flex-end;
    max-width: 860px;
    margin: 0;
    padding: 32px 40px;
    border-radius: 36px 36px 8px 36px;
    background: var(--tertiary);
    color: var(--on-tertiary);
    font: 700 28px/38px var(--font-display);
    letter-spacing: -0.015em;
    box-shadow: var(--shadow-sticker);
  }

  @media (min-width: 768px) {
    .problem-row {
      gap: 6px;
      padding: 22px 0;
    }
    .problem-title {
      font: 700 28px/36px var(--font-display);
      letter-spacing: -0.02em;
    }
    .problem-body {
      max-width: 400px;
      font-size: 17px;
      line-height: 26px;
    }
  }

  @media (min-width: 1100px) {
    .problem-row {
      flex-direction: row;
      align-items: baseline;
      gap: 40px;
    }
    /* Baris bertangga */
    .problem-row:nth-child(2) {
      padding-left: 180px;
    }
    .problem-row:nth-child(3) {
      padding-left: 360px;
    }
    .problem-title {
      width: 440px;
      flex-shrink: 0;
      font-size: 34px;
      line-height: 42px;
    }
  }
</style>
