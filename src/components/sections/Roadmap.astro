---
/**
 * Roadmap: "Bukti dulu, fitur kemudian." Log tiga chapter; chapter aktif diberi titik pink
 * bercincin, label "kamu di sini", dan sticker Tsuba.
 *
 * Mobile: lead versi pendek, baris rata atas.
 * Desktop (1100px+): judul 6 kolom + lead 6 kolom rata bawah; log maksimal 880px, baris rata tengah.
 */
import { roadmap } from '../../data/content';
import { getSticker, stickerAlt } from '../../data/stickers';
---

<section aria-labelledby="roadmap-heading" class="section-y md:bg-surface-sunken wide:pb-24">
  <div class="container-page flex flex-col gap-6 md:gap-11">
    <div class="grid gap-6 wide:grid-cols-12 wide:items-end wide:gap-12">
      <h2 id="roadmap-heading" class="heading-section wide:col-span-6">{roadmap.heading}</h2>
      <p class="lead-section md:hidden">{roadmap.leadMobile}</p>
      <p class="lead-section hidden md:block wide:col-span-6">{roadmap.lead}</p>
    </div>

    <ol aria-label="Tahapan Konnetto" class="rm-log">
      {
        roadmap.chapters.map((chapter) => (
          <li class:list={['rm-row', chapter.now && 'is-now']}>
            <span class="rm-dot" aria-hidden="true" />
            <div class="rm-main">
              <div class="rm-head">
                <h3 class="rm-title">{chapter.title}</h3>
                {chapter.now && <span class="rm-here">{roadmap.hereLabel}</span>}
              </div>
              <p class="rm-desc">{chapter.body}</p>
            </div>
            {chapter.stickerId && (
              <img
                class="rm-stk"
                src={getSticker(chapter.stickerId).url}
                alt={stickerAlt(getSticker(chapter.stickerId))}
                width="64"
                height="64"
                loading="lazy"
                decoding="async"
              />
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .rm-log {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .rm-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 18px 0;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }
  .rm-row:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .rm-dot {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin-top: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .is-now .rm-dot {
    background: var(--tertiary);
    box-shadow: 0 0 0 5px rgb(245 180 207 / 0.18);
  }
  .rm-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .rm-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .rm-title {
    margin: 0;
    font: 700 18px/24px var(--font-sans);
    color: var(--ink-muted);
  }
  .is-now .rm-title {
    color: var(--ink);
  }
  .rm-here {
    padding: 2px 9px;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--tertiary);
    font: 700 12px/16px var(--font-sans);
    color: var(--accent-pink);
  }
  .rm-desc {
    margin: 0;
    font: 400 16px/24px var(--font-sans);
    color: var(--ink-muted);
  }
  .is-now .rm-desc {
    color: var(--ink);
  }
  .rm-stk {
    flex-shrink: 0;
    display: block;
    width: 52px;
    height: 52px;
    object-fit: contain;
    transform: rotate(6deg);
    filter: drop-shadow(0 4px 10px rgb(6 3 14 / 0.45));
  }

  @media (min-width: 1100px) {
    .rm-log {
      max-width: 880px;
    }
    .rm-row {
      align-items: center;
      gap: 20px;
      padding: 22px 4px;
    }
    .rm-dot {
      margin-top: 0;
    }
    .rm-title {
      font-size: 20px;
      line-height: 26px;
    }
    .rm-desc {
      font-size: 17px;
      line-height: 26px;
    }
    .rm-stk {
      width: 64px;
      height: 64px;
    }
  }
</style>
