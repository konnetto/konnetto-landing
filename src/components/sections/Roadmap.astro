---
/**
 * Roadmap: "Bukti dulu, fitur kemudian." Log tiga chapter; chapter aktif diberi titik pink
 * bercincin, label "kamu di sini", dan sticker.
 *
 * Mobile: lead versi pendek, baris rata atas.
 * Desktop (1100px+): judul 6 kolom + lead 6 kolom rata bawah; log maksimal 880px, baris rata tengah.
 * Log-nya komponen bersama (StepLog), juga dipakai "Cara kerjanya" di halaman karier.
 */
import { roadmap } from '../../data/content';
import StepLog from '../StepLog.astro';

const steps = roadmap.chapters.map((chapter) => ({
  title: chapter.title,
  body: chapter.body,
  now: chapter.now,
  badge: chapter.now ? roadmap.hereLabel : undefined,
  stickerId: chapter.stickerId,
}));
---

<section aria-labelledby="roadmap-heading" class="section-y md:bg-surface-sunken wide:pb-24">
  <div class="container-page flex flex-col gap-6 md:gap-11">
    <div class="grid gap-6 wide:grid-cols-12 wide:items-end wide:gap-12">
      <h2 id="roadmap-heading" class="heading-section wide:col-span-6">{roadmap.heading}</h2>
      <p class="lead-section md:hidden">{roadmap.leadMobile}</p>
      <p class="lead-section hidden md:block wide:col-span-6">{roadmap.lead}</p>
    </div>

    <StepLog label="Tahapan Konnetto" steps={steps} />
  </div>
</section>
