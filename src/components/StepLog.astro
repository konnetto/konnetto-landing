---
/**
 * Daftar langkah bergaris (dari artboard: Roadmap di beranda, "Cara kerjanya" di halaman karier).
 * Langkah aktif (`now`) diberi titik pink bercincin, teks putih, dan label opsional (`badge`),
 * misalnya "kamu di sini" atau "mulai dari sini". Sticker opsional di ujung kanan baris.
 *
 * Mobile: baris rata atas. Desktop (1100px+): baris rata tengah, maksimal 880px.
 */
import { getSticker, stickerAlt, type StickerId } from '../data/stickers';

export interface Step {
  title: string;
  body: string;
  now?: boolean;
  badge?: string;
  stickerId?: StickerId;
}

interface Props {
  /** aria-label untuk daftar, misalnya "Tahapan Konnetto". */
  label: string;
  steps: Step[];
}

const { label, steps } = Astro.props;
---

<ol aria-label={label} class="rm-log">
  {
    steps.map((step) => (
      <li class:list={['rm-row', step.now && 'is-now']}>
        <span class="rm-dot" aria-hidden="true" />
        <div class="rm-main">
          <div class="rm-head">
            <h3 class="rm-title">{step.title}</h3>
            {step.badge && <span class="rm-here">{step.badge}</span>}
          </div>
          <p class="rm-desc">{step.body}</p>
        </div>
        {step.stickerId && (
          <img
            class="rm-stk"
            src={getSticker(step.stickerId).url}
            alt={stickerAlt(getSticker(step.stickerId))}
            width="64"
            height="64"
            loading="lazy"
            decoding="async"
          />
        )}
      </li>
    ))
  }
</ol>

<style>
  .rm-log {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .rm-row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 18px 0;
    border-top: 1px solid rgb(255 255 255 / 0.08);
  }
  .rm-row:last-child {
    border-bottom: 1px solid rgb(255 255 255 / 0.08);
  }
  .rm-dot {
    flex-shrink: 0;
    width: 10px;
    height: 10px;
    margin-top: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .is-now .rm-dot {
    background: var(--tertiary);
    box-shadow: 0 0 0 5px rgb(245 180 207 / 0.18);
  }
  .rm-main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .rm-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }
  .rm-title {
    margin: 0;
    font: 700 18px/24px var(--font-sans);
    color: var(--ink-muted);
  }
  .is-now .rm-title {
    color: var(--ink);
  }
  .rm-here {
    padding: 2px 9px;
    border-radius: var(--radius-pill);
    box-shadow: inset 0 0 0 1px var(--tertiary);
    font: 700 12px/16px var(--font-sans);
    color: var(--accent-pink);
    white-space: nowrap;
  }
  .rm-desc {
    margin: 0;
    font: 400 16px/24px var(--font-sans);
    color: var(--ink-muted);
  }
  .is-now .rm-desc {
    color: var(--ink);
  }
  .rm-stk {
    flex-shrink: 0;
    display: block;
    width: 52px;
    height: 52px;
    object-fit: contain;
    transform: rotate(6deg);
    filter: drop-shadow(0 4px 10px rgb(6 3 14 / 0.45));
  }

  @media (min-width: 1100px) {
    .rm-log {
      max-width: 880px;
    }
    .rm-row {
      align-items: center;
      gap: 20px;
      padding: 22px 4px;
    }
    .rm-dot {
      margin-top: 0;
    }
    .rm-title {
      font-size: 20px;
      line-height: 26px;
    }
    .rm-desc {
      font-size: 17px;
      line-height: 26px;
    }
    .rm-stk {
      width: 64px;
      height: 64px;
    }
  }
</style>
