# Salin ke .env lalu isi. Semua variabel berawalan PUBLIC_ akan ikut
# ter-bundle ke JavaScript di browser, jadi JANGAN taruh secret di sini.

# URL produksi (untuk canonical dan OG image)
PUBLIC_SITE_URL=https://konnetto.id

# Base URL gambar (avatar, sticker, Tsuba). Kosongkan = pakai public/img.
# Isi setelah gambar di-upload ke cloud storage, contoh https://assets.konnetto.id
PUBLIC_ASSET_BASE_URL=

# --- Form ---
# Pilih salah satu: formspree | tally | demo
# Selama endpoint/ID form kosong, form otomatis jalan di mode demo (bisa dicoba, data tidak disimpan).
PUBLIC_FORM_PROVIDER=formspree
# Formspree: endpoint form, contoh https://formspree.io/f/abcdwxyz
PUBLIC_FORMSPREE_ENDPOINT=
# Tally: ID form (bagian terakhir URL tally.so/r/<ID>), satu untuk tiap peran
PUBLIC_TALLY_FANS_FORM_ID=
PUBLIC_TALLY_CREATOR_FORM_ID=

# --- Analytics (Umami) ---
# Kosongkan untuk mematikan analytics (misalnya saat development)
PUBLIC_UMAMI_WEBSITE_ID=
# Ganti kalau self-host Umami
PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
